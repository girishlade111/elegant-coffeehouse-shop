---
/**
 * Left phone — the "Coffee" menu screen.
 *
 * Purely presentational: the whole phone is exposed to assistive tech as a
 * single image, so nothing inside it is focusable and every glyph is
 * aria-hidden.
 */
import Icon from './Icon.astro';
import ProductCard from './ProductCard.astro';
import { app, hero, moccaccino, products } from '../data/site';

const label =
  'Flavored app, Coffee menu screen: a list of coffees with prices and a floating bottom navigation bar';
---

<div class="phone phone--menu" role="img" aria-label={label}>
  <div class="phone__screen">
    <span class="phone__back"><Icon name="chevron-left" size={16} /></span>

    <h3 class="phone__title">{app.menuScreen.title}</h3>
    <span class="phone__cta">{app.menuScreen.cta}</span>

    <ul class="phone__chips">
      {
        hero.chips.map((chip) => (
          <li class="phone__chip">
            <Icon name={chip.icon} size={16} />
          </li>
        ))
      }
    </ul>

    <div class="phone__cards">
      {
        products.map((product) => (
          <ProductCard
            name={product.name}
            desc={product.desc}
            price={product.price}
            img={product.img}
            art={product.art}
            alt={product.alt}
            tone={product.tone}
            compact
            decorative
          />
        ))
      }
    </div>

    <div class="phone__wide">
      <h4 class="phone__wide-name">{moccaccino.name}</h4>
      <p class="phone__wide-desc">{moccaccino.desc}</p>
    </div>
  </div>

  <div class="phone__nav">
    {
      app.menuScreen.nav.map((item) => (
        <span class:list={['phone__nav-item', item.current && 'is-current']}>
          <Icon name={item.icon} size={16} stroke={1.5} />
        </span>
      ))
    }
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 316px;
    height: 685px;
    border-radius: 44px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: linear-gradient(165deg, #c7b2b0 0%, #e4d6ca 50%, #f1e8da 100%);
    box-shadow: var(--shadow-card);
    color: var(--espresso-900);
  }

  .phone__screen {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    padding: 20px;
  }

  .phone__back {
    display: block;
  }

  .phone__title {
    margin-top: 14px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .phone__cta {
    display: inline-flex;
    align-items: center;
    height: 28px;
    margin-top: 10px;
    padding-inline: 18px;
    border-radius: var(--radius-pill);
    background: var(--espresso-900);
    color: var(--cream-50);
    font-size: 11px;
    font-weight: 500;
  }

  .phone__chips {
    display: flex;
    gap: 12px;
    margin-top: 14px;
  }

  .phone__chip {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.5);
  }

  .phone__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    /* clear the 70px cups that hang 30px above the cards */
    margin-top: 36px;
  }

  .phone__wide {
    width: 100%;
    margin-top: 40px;
    padding: 18px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.32);
  }

  .phone__wide-name {
    font-size: 10px;
    font-weight: 700;
    line-height: 1.3;
  }

  .phone__wide-desc {
    margin-top: 5px;
    font-size: 7px;
    line-height: 1.5;
    opacity: 0.8;
  }

  /* --- floating bottom navigation ---------------------------------------- */

  .phone__nav {
    position: absolute;
    inset: auto 14px 14px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    height: 48px;
    border-radius: var(--radius-pill);
    background: var(--espresso-900);
    color: var(--cream-50);
    box-shadow: 0 16px 28px -16px rgba(42, 10, 10, 0.75);
  }

  .phone__nav-item {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }

  .phone__nav-item.is-current {
    background: radial-gradient(circle, rgba(255, 248, 238, 0.4) 0%, transparent 72%);
  }
</style>
