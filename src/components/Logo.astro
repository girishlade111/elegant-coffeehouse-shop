---
/**
 * The "Flavored" wordmark: the cup glyph sits at the top-right of the word,
 * with the tagline running underneath both.
 */
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  /** `light` is used in the footer, where the shell turns dark. */
  variant?: 'dark' | 'light';
  /** Wordmark size in px. */
  size?: number;
  class?: string;
}

const { variant = 'dark', size = 28, class: className = '' } = Astro.props;
---

<span class={`logo logo--${variant} ${className}`.trim()} style={`--logo-size:${size}px`}>
  <span class="logo__row">
    <span class="logo__word">{site.name}</span>
    <Icon name="cup-steam" size={Math.round(size * 0.78)} stroke={1.5} class="logo__mark" />
  </span>
  <span class="logo__tagline">{site.tagline}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    line-height: 1;
    color: var(--espresso-900);
  }

  .logo--light {
    color: var(--cream-50);
  }

  .logo__row {
    display: inline-flex;
    align-items: flex-start;
    gap: 6px;
  }

  .logo__word {
    font-size: var(--logo-size);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .logo__mark {
    margin-top: 1px;
  }

  .logo__tagline {
    /* Scales with the wordmark: the reference's footer tagline measures 177px
       wide against a 145px wordmark. */
    font-size: calc(var(--logo-size) * 0.45);
    font-weight: 400;
    line-height: 1.3;
    opacity: 0.8;
  }
</style>
