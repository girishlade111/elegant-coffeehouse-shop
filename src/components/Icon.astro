---
/**
 * The only place SVG icon geometry lives.
 *
 * Every glyph is drawn on a 24x24 grid with round caps/joins and inherits
 * `currentColor`, so an icon can be recoloured from its parent. Stroke icons
 * share one stroke weight (`stroke` prop, default 1.6); the two store badges
 * are solid glyphs and opt out via `filled`.
 */
export type IconName =
  | 'cup-steam'
  | 'iced-glass'
  | 'takeaway-mug'
  | 'beans'
  | 'cart'
  | 'heart'
  | 'home'
  | 'user'
  | 'sliders'
  | 'chevron-left'
  | 'plus'
  | 'apple'
  | 'google-play';

interface IconDef {
  /** Inner markup of the <svg>. */
  readonly body: string;
  /** Solid glyph — no stroke, filled with currentColor. */
  readonly filled?: boolean;
}

const ICONS: Record<IconName, IconDef> = {
  /* coffee cup on a saucer, two curls of steam */
  'cup-steam': {
    body: `<path d="M4.2 12.8h11.6v2.9a4.7 4.7 0 0 1-4.7 4.7H8.9a4.7 4.7 0 0 1-4.7-4.7z"/>
      <path d="M15.8 14h1.4a2.7 2.7 0 0 1 0 5.4h-1.4"/>
      <path d="M3 21.9h16.4"/>
      <path d="M8.8 10.2c-1.1-1.2 1.1-2 0-3.2s1.1-2 0-3.2"/>
      <path d="M12.6 10.2c-1.1-1.2 1.1-2 0-3.2s1.1-2 0-3.2"/>`,
  },

  /* tall iced glass — domed lid + straw */
  'iced-glass': {
    body: `<path d="M6.8 8.5a5.2 5.2 0 0 1 10.4 0"/>
      <path d="M6.1 8.5h11.8"/>
      <path d="M7.1 8.5l.9 10.8a2.1 2.1 0 0 0 2.1 1.9h3.8a2.1 2.1 0 0 0 2.1-1.9l.9-10.8"/>
      <path d="M13.6 2.8l2.2 5.7"/>`,
  },

  /* takeaway cup with a lid and a handle */
  'takeaway-mug': {
    body: `<path d="M6.6 8.7l.5-1.9a1.6 1.6 0 0 1 1.5-1.2h4.8a1.6 1.6 0 0 1 1.5 1.2l.5 1.9"/>
      <path d="M5.5 8.7h13"/>
      <path d="M6.8 8.7l.9 10.3a2.1 2.1 0 0 0 2.1 1.9h2.4a2.1 2.1 0 0 0 2.1-1.9l.9-10.3"/>
      <path d="M17 11.5h1.1a2.5 2.5 0 0 1 0 5h-1.7"/>
      <path d="M11.8 4.4c-.9-1 .9-1.7 0-2.7"/>`,
  },

  /* two roasted beans */
  beans: {
    body: `<g transform="rotate(-32 9.1 8.7)">
        <ellipse cx="9.1" cy="8.7" rx="3.3" ry="4.7"/>
        <path d="M9.1 4.4c-1.5 1.5 1.5 2.9 0 4.3s1.5 2.9 0 4.3"/>
      </g>
      <g transform="rotate(28 15.4 15.7)">
        <ellipse cx="15.4" cy="15.7" rx="3.1" ry="4.4"/>
        <path d="M15.4 11.7c-1.4 1.4 1.4 2.7 0 4s1.4 2.7 0 4"/>
      </g>`,
  },

  cart: {
    body: `<path d="M2.8 4.4h2.4l2.3 10.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 1.9-1.5l1.4-5.8H6"/>
      <circle cx="9.7" cy="19.5" r="1.3"/>
      <circle cx="17.3" cy="19.5" r="1.3"/>`,
  },

  heart: {
    body: `<path d="M12 20.4C9.5 18.5 4.3 14.5 4.3 10.7a4.6 4.6 0 0 1 7.7-3 4.6 4.6 0 0 1 7.7 3c0 3.8-5.2 7.8-7.7 9.7z"/>`,
  },

  home: {
    body: `<path d="M4 10.4 12 4.1l8 6.3V19a1.8 1.8 0 0 1-1.8 1.8H5.8A1.8 1.8 0 0 1 4 19z"/>
      <path d="M9.4 20.8v-5.3h5.2v5.3"/>`,
  },

  user: {
    body: `<path d="M12 11.6a3.7 3.7 0 1 0 0-7.4 3.7 3.7 0 0 0 0 7.4z"/>
      <path d="M5.4 20.3c.9-3.5 3.5-5.6 6.6-5.6s5.7 2.1 6.6 5.6"/>`,
  },

  sliders: {
    body: `<path d="M3.6 7h16.8"/>
      <path d="M3.6 12h16.8"/>
      <path d="M3.6 17h16.8"/>
      <circle cx="15.8" cy="7" r="1.9" fill="currentColor" stroke="none"/>
      <circle cx="8.4" cy="12" r="1.9" fill="currentColor" stroke="none"/>
      <circle cx="14.6" cy="17" r="1.9" fill="currentColor" stroke="none"/>`,
  },

  'chevron-left': {
    body: `<path d="M14.6 5.4 8 12l6.6 6.6"/>`,
  },

  plus: {
    body: `<path d="M12 5.6v12.8M5.6 12h12.8"/>`,
  },

  apple: {
    filled: true,
    body: `<path d="M16.7 12.7c0-2.2 1.8-3.3 1.9-3.3-1-1.5-2.6-1.7-3.2-1.8-1.4-.1-2.6.8-3.3.8-.7 0-1.7-.8-2.8-.8-1.5 0-2.8.8-3.6 2.1-1.5 2.6-.4 6.5 1.1 8.6.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7 1.3 0 1.6.7 2.8.7 1.1 0 1.9-1.1 2.6-2.1.8-1.2 1.1-2.3 1.2-2.4-.1 0-2.3-.9-2.2-3.2z"/>
      <path d="M14.6 6.2c.6-.7 1-1.7.9-2.7-.9 0-2 .6-2.6 1.3-.6.7-1.1 1.7-.9 2.7 1 .1 1.9-.5 2.6-1.3z"/>`,
  },

  'google-play': {
    filled: true,
    body: `<path d="M3.8 2.6C3.4 2.9 3.1 3.5 3.1 4.2v15.6c0 .7.3 1.3.7 1.6l9.4-9.4L3.8 2.6z"/>
      <path d="M6.3 1.8 18 8.5c.9.5 1.3 1.2 1.3 1.9l-3.6 1.6L6.3 1.8z"/>
      <path d="M6.3 22.2 18 15.5c.9-.5 1.3-1.2 1.3-1.9l-3.6-1.6L6.3 22.2z"/>`,
  },
};

interface Props {
  name: IconName;
  /** Rendered size in px (the SVG is square). */
  size?: number;
  /** Stroke weight for outline glyphs. */
  stroke?: number;
  class?: string;
}

const { name, size = 24, stroke = 1.6, class: className = '' } = Astro.props;
const icon = ICONS[name];
---

<svg
  class={`icon ${className}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width={icon.filled ? undefined : stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  ><Fragment set:html={icon.body} /></svg
>

<style>
  .icon {
    display: block;
    flex: none;
    overflow: visible;
  }
</style>
